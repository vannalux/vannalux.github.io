              }
            },
            "H2": {
              "color": "#ff0000"
            },
            "P": {
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#ff7d19"
            }
          },
          "_name": "design-block",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article021\" group=\"Article\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" name=\"reverseContent\" title=\"Reverse\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" name=\"showButton\" title=\"Buttons\">\n\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#2b7a69\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n        \n                 <input type=\"image\" title=\"Image 1\" name=\"imagevalue1\" value=\"https://www.unsitepourtous.be/mobi/img/flower1.jpg\">\n              <input type=\"image\" title=\"Image 2\" name=\"imagevalue2\" value=\"https://www.unsitepourtous.be/mobi/img/flower2.jpg\">\n                   <input type=\"image\" title=\"Image 3\" name=\"imagevalue3\" value=\"https://www.unsitepourtous.be/mobi/img/flower3.jpg\">\n                        <input type=\"image\" title=\"Image 4\" name=\"imagevalue4\" value=\"https://www.unsitepourtous.be/mobi/img/flower4.jpg\">\n                             <input type=\"image\" title=\"Image 5\" name=\"imagevalue5\" value=\"https://www.unsitepourtous.be/mobi/img/flower5.jpg\">\n                                    <input type=\"color\" title=\"Background Color\" name=\"colorbarre1\" value=\"#000000\">\n                                     <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacitybarre1\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\">\n\n                                                                         <input type=\"checkbox\" title=\"Grayscale hover\" name=\"grayScale2\" checked>\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-lg-4\">\n                <div class=\"col-12 col-md-12\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style mt-0 mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">\n                        <b>Flowers</b><br><b>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Power</b></h2>\n                    <h3 class=\"mbr-section-subtitle mbr-fonts-style mt-0 mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle, .main-button\" mbr-theme-style=\"display-7\">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vestibulum iaculis nisl sed dictum aliquam.</h3>\n                    <div class=\"mbr-section-btn item-footer mt-3  main-button\" mbr-if=\"showButton\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\">\n                        <a href class=\"btn item-btn btn-primary\" data-app-placeholder=\"Type Text\">\n                            Learn more\n                        </a>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-lg-8 side-features\">\n <div class=\"accordion\">\n\n        <!-- BOX 1 -->\n        <div class=\"box a1\">\n            <div class=\"image_1\">\n                <div class=\"text\">\n                    <h2>Lorem Ipsum</h2>\n                    <p>\n                        Lorem ipsum dolor sit amet, consectetur adipiscing elit.\n                        Vestibulum iaculis nisl sed dictum aliquam.\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        <!-- BOX 2 -->\n        <div class=\"box a2\">\n            <div class=\"image_2\">\n                <div class=\"text\">\n                    <h2>Lorem Ipsum</h2>\n                    <p>\n                        Lorem ipsum dolor sit amet, consectetur adipiscing elit.\n                        Vestibulum iaculis nisl sed dictum aliquam.\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        <!-- BOX 3 -->\n        <div class=\"box a3\">\n            <div class=\"image_3\">\n                <div class=\"text\">\n                    <h2>Lorem Ipsum</h2>\n                    <p>\n                        Lorem ipsum dolor sit amet, consectetur adipiscing elit.\n                        Vestibulum iaculis nisl sed dictum aliquam.\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        <!-- BOX 1 -->\n        <div class=\"box a4\">\n            <div class=\"image_4\">\n                <div class=\"text\">\n                    <h2>Lorem Ipsum</h2>\n                    <p>\n                        Lorem ipsum dolor sit amet, consectetur adipiscing elit.\n                        Vestibulum iaculis nisl sed dictum aliquam.\n                    </p>\n                </div>\n            </div>\n        </div>\n\n        <!-- BOX 5 -->\n        <div class=\"box a5\">\n            <div class=\"image_5\">\n                <div class=\"text\">\n                    <h2>Lorem Ipsum</h2>\n                    <p>\n                        Lorem ipsum dolor sit amet, consectetur adipiscing elit.\n                        Vestibulum iaculis nisl sed dictum aliquam.\n                    </p>\n                </div>\n            </div>\n        </div>\n\n    </div>\n            </div>\n        </div>\n    </div>\n    \n\n</section>",
