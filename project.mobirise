        {
          "alias": false,
          "_styles": {},
          "_name": "header5",
          "_sourceTheme": "direct-m",
          "_customHTML": "<section data-bs-version=\"5.1\" mbr-id=\"_anchor\" class=\"mbr-section mbr-section-hero mbr-section-full header5\" mbr-class-mbr-parallax-background=\"_params.parallax | if _params.bgImageRadio\" mbr-class-mbr-section-with-arrow=\"_params.showArrow\" mbr-bg-image=\"_params.bgImage | if _params.bgImageRadio\" mbr-bg-color=\"_params.bgColor | if _params.bgColorRadio\" mbr-bg-video=\"_params.bgVideo.url | if _params.bgVideoRadio\">\n\n    <div class=\"mbr-overlay\" mbr-if=\"_params.overlay | unless _params.bgColorRadio\" mbr-opacity=\"_params.overlayOpacity\" mbr-bg-color=\"_params.overlayColor\"></div>\n        \n    <div class=\"mbr-table-cell\">\n        <div class=\"container\">\n            <div class=\"row heading\">\n                <div class=\"col-md-10\" mbr-class-col-md-offset-1=\"_params.contentAlign | eq 'center'\" mbr-class-col-md-offset-2=\"_params.contentAlign | eq 'right'\" mbr-class-text-xs-center=\"_params.contentAlign | eq 'center'\" mbr-class-text-xs-right=\"_params.contentAlign | eq 'right'\">\n\n                    <h1 class=\"mbr-section-title display-1 heading-title\" mbr-if=\"_params.showTitle\" mbr-html=\"title\" data-app-edit=\"content\" data-app-selector=\".heading-title\" data-app-placeholder=\"Type Title\">\n                    </h1>\n                    <p class=\"mbr-section-subtitle sub-2 heading-text\" mbr-if=\"_params.showText\" mbr-html=\"text\" data-app-edit=\"content\" data-app-selector=\".heading-text\" data-app-placeholder=\"Type Text\">\n                    </p>\n                    <div class=\"mbr-section-btn\" mbr-if=\"_params.showButtons | if buttons\" mbr-html=\"buttons\" data-app-edit=\"buttons\" data-toolbar=\"-mbrBtnMove\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>    \n\n</section>",
