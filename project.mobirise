          "_name": "divider",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section class>\n  \n    <mbr-parameters>\n      <!-- Block parameters controls (Blue \"Gear\" panel) -->\n      <input type=\"color\" title=\"Top Color\" name=\"topcolor\" value=\"#ffe161\">\n      <input type=\"color\" title=\"Bottom Color\" name=\"bottomcolor\" value=\"#e43f3f\">\n      <select title=\"Shape\" name=\"shape\">\n        \n        <option value=\"1\">Cats down</option>\n<option value=\"2\" selected>Cats up</option>        \n<option value=\"3\">Dogs/cats down</option>\n        <option value=\"4\">Dogs/cats up</option>\n          <option value=\"5\">Guitar down</option>\n        <option value=\"6\">Guitar up</option>\n      </select>\n      <!-- End block parameters -->\n    </mbr-parameters>\n\n\n\n\t\n\n\n\t<svg mbr-if=\"shape == 3\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1107.36 216.34\" style=\"shape-rendering:geometricPrecision; text-rendering:geometricPrecision; image-rendering:optimizeQuality; fill-rule:evenodd; clip-rule:evenodd\">\n <path class=\"top\" d=\"M0.55 215.79l1106.25 0 0 -180.45c-6.04,-1.1 -12,-2.88 -18.33,-3.92 -28.95,-4.73 -71.08,-2.78 -97.57,8.81 -32.51,14.23 -41.47,33.64 -91.45,42.14 -25.58,4.35 -56.42,4.74 -81.97,-0.08 -30.76,-5.8 -40.88,-10.51 -69.27,-19.75 -24.75,-8.06 -46.56,-14.25 -75,-13.75 -55.75,0.99 -93.97,19.14 -138.11,39.7 -20.27,9.45 -40.25,19.22 -60.88,28.17 -9.47,4.1 -23.51,8.14 -34.24,10.27 -65.23,12.96 -133.78,2.49 -195.39,-14.69 -76.29,-21.29 -148.6,-54.86 -216.6,-94.65l-27.44 -16.61 0 214.81zm65.12 -82.92c2.87,-0.91 4.1,3.67 1.24,4.5 -2.85,0.81 -4.63,-3.42 -1.24,-4.5zm-2.37 -3.26c-2.96,0.64 -5.41,3.38 -4.6,7.11 1.59,7.33 13.21,5.22 11.55,-2.6 -0.59,-2.77 -3.45,-5.27 -6.95,-4.51zm26.73 3.14c3.17,-0.7 3.94,3.92 1.04,4.61 -3,0.72 -4.06,-3.94 -1.04,-4.61zm-2.68 -3.1c-7.91,2.2 -4.27,13.48 3.09,11.37 7.35,-2.1 4.4,-13.46 -3.09,-11.37zm-10.94 26.08c-1.22,-0.51 -4.18,-5.41 -4.33,-6.46 3.01,-0.12 5.26,-0.1 8.24,0.09 -0.73,2.39 -2.77,4.95 -3.91,6.37zm-6.49 -8.08c-0.89,2.44 3.93,8.16 