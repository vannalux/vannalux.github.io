          "_name": "video1",
          "_sourceTheme": "direct-m",
          "_customHTML": "<section data-bs-version=\"5.1\" mbr-id=\"_anchor\" class=\"mbr-section video1 mbr-section-nopadding\" mbr-bg-color=\"_params.bgColor\">\n\n    <div class=\"mbr-figure\">\n        <div mbr-media=\"media\"></div>\n        <div class=\"mbr-figure-caption\" mbr-if=\"_params.showText\">\n            <div class=\"container\" mbr-html=\"text\" data-app-edit=\"content\" data-app-placeholder=\"Type Text\">\n            </div>\n        </div>\n    </div>\n\n</section>",
