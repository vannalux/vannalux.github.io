        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-box": {
              "padding": "2rem",
              "width": "58.33%"
            },
            ".img-wrapper": {
              "width": "41.66%",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center"
            },
            ".img1": {
              "background": "@cardColor2"
            },
            ".img2": {
              "background": "@cardColor3"
            },
            ".mbr-iconfont": {
              "display": "block",
              "font-size": "8rem",
              "color": "@iconColor",
              "margin-bottom": "2rem"
            },
            ".card": {
              "margin": "auto",
              "min-height": "280px",
              "transition": "all 0.3s"
            },
            ".card-wrapper": {
              "background": "@cardColor",
              "border-radius": "(@SkruglenieRamki * 1px) !important",
              "display": "flex",
              "overflow": "hidden",
              "justify-content": "space-between",
              "border-color": "@BorderColor",
              "border-width": "(@tolchinaRamki * 1px)",
              "border-style": "~\"@{StiliRamki}\""
            },
            "@media (max-width: 992px)": {
              ".card-wrapper": {
                "margin-bottom": "2rem"
              }
            },
            "@media (max-width: 767px)": {
              ".card-wrapper": {
                "flex-direction": "column"
              },
              ".card-box": {
                "padding": "1rem"
              },
              ".card-box, .img-wrapper": {
                "width": "100%"
              },
              ".img-wrapper": {
                "padding": "4rem 1rem"
              },
              ".mbr-flex": {
                "flex-direction": "column-reverse"
              }
            },
            ".card-subtitle": {
              "color": "#0077ff"
            },
            ".mbr-text, .link-wrap": {
              "color": "#555555"
            },
            ".card-title, .card-box": {
              "color": "#ff7d19"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#0c2c68"
            }
          },
          "_name": "features6",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n        </select>\n        <header>Show/Hide</header>\n\t\t\t\t<input type=\"range\" inline title=\"Толщина рамки  (px)\" name=\"tolchinaRamki\" min=\"0\" max=\"30\" step=\"1\" value=\"7\">\n\t\t\t\t<select title=\"Стиль Рамки\" name=\"StiliRamki\">\n\t\t\t<option value=\"solid\">Линия</option>\n\t\t\t<option value=\"dotted\">Точки</option>\n\t\t\t<option value=\"double\" selected>Двойная линия</option>\n                        <option value=\"dashed\">Пунктир</option>\n\t\t</select>\n\t\t\t\t<input type=\"range\" inline title=\"Скругление  (px)\" name=\"SkruglenieRamki\" min=\"0\" max=\"99\" step=\"1\" value=\"16\">\n\t\t\t\t<input type=\"color\" title=\"Цвет рамки\" name=\"BorderColor\" value=\"#c8dce2\">\n\t\t\t\t\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showsubTitle\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Colors</header>\n        <input type=\"color\" title=\"Bg\" name=\"cardColor\" value=\"#f7f7f7\" selected>\n        <input type=\"color\" title=\"Icon 1\" name=\"cardColor2\" value=\"#ffe161\" selected>\n        <input type=\"color\" title=\"Icon 2\" name=\"cardColor3\" value=\"#6592e6\" selected condition=\"cardsAmount > 1\">\n        <input type=\"color\" title=\"Icon\" name=\"iconColor\" value=\"#d20320\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"card col-12 col-lg-6\">\n                <div class=\"card-wrapper mbr-flex\">\n                    <div class=\"card-box align-left\">\n                        <h6 class=\"card-subtitle mbr-fonts-style align-left mb-2\" mbr-theme-style=\"display-4\" mbr-if=\"showsubTitle\" data-app-selector=\".card-subtitle\">\n                            Elevate your business\n                        </h6>\n                        <h2 class=\"card-title mbr-fonts-style align-left mb-3\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-box\">\n                            <b>No Coding</b>\n                        </h2>\n                        <p class=\"mbr-text mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                            You don't have to code when you create your own site. Select one of available themes in the Mobirise sitebuilder.</p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a href=\"https://mobiri.se\" class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">Learn more</a>\n                        </div>\n                    </div>\n                    <div class=\"img-wrapper img1 align-center\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-setting mobi-mbri\"></span>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-lg-6\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper mbr-flex\">\n                    <div class=\"card-box align-left\">\n                        <h6 class=\"card-subtitle mbr-fonts-style align-left mb-2\" mbr-theme-style=\"display-4\" mbr-if=\"showsubTitle\" data-app-selector=\".card-subtitle\">\n                            Elevate your business\n                        </h6>\n                        <h2 class=\"card-title mbr-fonts-style align-left mb-3\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .card-box\">\n                            <b>Unique Styles</b>\n                        </h2>\n                        <p class=\"mbr-text mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                            Select the theme that suits you. Each theme in the Mobirise website building software contains a set of unique blocks.</p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                            <a href=\"https://mobiri.se\" class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">Learn more</a>\n                        </div>\n                    </div>\n                    <div class=\"img-wrapper img2 align-center\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-users mobi-mbri\"></span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vrHPngUxLn",
          "_anchor": "features6-3n",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {},
          "_name": "header8",
          "_sourceTheme": "direct-m",
          "_customHTML": "<section data-bs-version=\"5.1\" mbr-id=\"_anchor\" class=\"mbr-section mbr-section-hero mbr-section-full header8\" mbr-class-mbr-parallax-background=\"_params.parallax | if _params.bgImageRadio\" mbr-bg-image=\"_params.bgImage | if _params.bgImageRadio\" mbr-bg-color=\"_params.bgColor | if _params.bgColorRadio\" mbr-bg-video=\"_params.bgVideo.url | if _params.bgVideoRadio\">\n\n    <div class=\"mbr-overlay\" mbr-if=\"_params.overlay | unless _params.bgColorRadio\" mbr-opacity=\"_params.overlayOpacity\" mbr-bg-color=\"_params.overlayColor\">\n    </div>\n        <div class=\"mbr-table-cell\">\n            <div class=\"container\">\n\n                    <div id=\"title\">\n                        <div class=\"mbr-figure image-size\" mbr-media=\"media\" mbr-if=\"_params.showImage\"></div>\n                        <div class=\"mbr-table-cell mbr-left-padding-md-up col-md-6 text-xs-center text-md-left\">\n\n                            <h3 class=\"mbr-section-title display-2\" mbr-if=\"_params.showTitle\" mbr-html=\"title\" data-app-edit=\"content\" data-app-placeholder=\"Type Title\">\n                            </h3>\n\n                            <div class=\"mbr-section-subtitle sub-2\">\n                                <p mbr-if=\"_params.showText\" mbr-html=\"text\" data-app-edit=\"content\" data-app-placeholder=\"Type Text\">\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"text-xs-center\" mbr-html=\"button\" mbr-if=\"_params.showButton\" data-app-edit=\"buttons\" data-toolbar=\"-mbrBtnMove\"></div>\n                    </div>\n            </div> \n        </div> \n    <div mbr-if=\"_params.showArrow\" class=\"mbr-arrow mbr-arrow-floating\" aria-hidden=\"true\"><a mbr-on-click=\"next\" href=\"#next\"><i class=\"mbri-down\"></i></a></div>            \n</section>",
          "_cid": "vrHNLoe2WY",
          "_anchor": "header8-3j",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            ".trans-wave": {
              "pointer-events": "none"
            },
            ".dentaura-container": {
              "height": "0px",
              "position": "relative",
              "width": "100%"
            },
            ".dentaura-y-up": {
              "position": "absolute",
              "& when (@flipVerti = false)": {
                "bottom": "0px"
              },
              "& when (@flipVerti)": {
                "top": "0px",
                "z-index": "@zindexOrderverti"
              },
              "left": "0",
              "width": "100%",
              "pointer-events": "none"
            },
            ".dentaura-cover": {
              "background": "transparent",
              "height": "(@heightWavecover * 1px)",
              "width": "100%",
              "position": "relative",
              "overflow": "hidden",
              "pointer-events": "none",
              "& when (@flipVerti)": {
                "-webkit-transform": "rotateX(180deg)",
                "-moz-transform": "rotateX(180deg)",
                "-o-transform": "rotateX(180deg)",
                "-ms-transform": "rotateX(180deg)",
                "transform": "rotateX(180deg)",
                "& when (@flipDownHori)": {
                  "-webkit-transform": "rotate(180deg)",
                  "-moz-transform": "rotate(180deg)",
                  "-o-transform": "rotate(180deg)",
                  "-ms-transform": "rotate(180deg)",
                  "transform": "rotate(180deg)"
                }
              },
              "& when (@flipVerti = false)": {
                "& when (@flipUpHori)": {
                  "-webkit-transform": "rotateY(180deg)",
                  "-moz-transform": "rotateY(180deg)",
                  "-o-transform": "rotateY(180deg)",
                  "-ms-transform": "rotateY(180deg)",
                  "transform": "rotateY(180deg)"
                }
              }
            },
            ".dentaura-y-down": {
              "position": "absolute",
              "bottom": "0px",
              "left": "0",
              "width": "100%",
              "pointer-events": "none"
            },
            ".hidden": {
              "display": "none"
            },
            ".fil0": {
              "fill": "@topcolor",
              "opacity": "@bottomcolortrans1"
            },
            ".fil2": {
              "fill": "@topcolor1",
              "opacity": "@bottomcolortrans2"
            },
            ".fil1": {
              "fill": "@topcolor2",
              "opacity": "@bottomcolortrans3"
            }
          },
          "_name": "design-block",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"mbr-section\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>DIVIDER CLOUDS</header>    \n        \n              <input type=\"color\" title=\"Color 1\" name=\"topcolor\" value=\"#55b4d4\">\n                <input type=\"range\" title=\"Transparency1 \" name=\"bottomcolortrans1\" value=\"0.4\" min=\"0\" max=\"1\" step=\"0.1\">\n            <input type=\"color\" title=\"Color 2\" name=\"topcolor1\" value=\"#0f7699\">\n              <input type=\"range\" title=\"Transparency 2\" name=\"bottomcolortrans2\" value=\"0.5\" min=\"0\" max=\"1\" step=\"0.1\">\n                  <input type=\"color\" title=\"Color 3\" name=\"topcolor2\" value=\"#073b4c\">\n        <input type=\"range\" title=\"Transparency 3\" name=\"bottomcolortrans3\" value=\"0.6\" min=\"0\" max=\"1\" step=\"0.1\">\n        \n         \n\n      <input type=\"color\" title=\"Fill Color\" name=\"fillcolor\" value=\"#ff0000\" condition=\"test == false\">\n        <input type=\"checkbox\" title=\"Flip Vertical\" name=\"flipVerti\">\n                <input type=\"checkbox\" title=\"Flip Horizontal\" name=\"flipUpHori\" condition=\"test == false\">\n        <input type=\"checkbox\" title=\"Flip Horizontal\" name=\"flipDownHori\" condition=\"test\" checked>\n\n        <header>BLOCK ORDER (applicable when flipped downwards and when used in combination with other dividers)</header>\n        <input type=\"range\" inline title=\"Move backwards or forwards\" name=\"zindexOrderverti\" min=\"1\" max=\"100\" step=\"1\" value=\"1\" condition=\"flipVerti\">\n        <header>Wave Cover</header>\n        <input type=\"range\" inline title=\"Wave Cover height to avoid wave getting cut off\" name=\"heightWavecover\" min=\"150\" max=\"600\" step=\"1\" value=\"235\">\n        <header>NOTE:</header>\n        <header>Adjust height of blocks overlapped accordingly to accommodate this wave divider. Use only in suitable situations (eg: not suitable for small footer blocks). Minimum overlapping height of this block is 250px.</header>\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"dentaura-container\">\n        <div class=\"dentaura-y-up\">\n            <div class=\"dentaura-cover\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1333.58 155.85\" class=\"dentaura-y-down\">\n                \n                  <path class=\"fil0\" d=\"M0 19.77l0 51.73c1.95,0.24 7.72,4.36 9.53,5.74l4.9 3.95c0.34,0.24 0.32,0.26 0.65,0.58 0.86,0.84 1.6,1.7 2.56,2.57 0.45,0.4 0.97,0.88 1.24,1.24 0.62,0.83 0.27,0.68 1.17,1.5 0.63,0.57 0.75,0.72 1.15,1.33 1.14,1.8 1.9,1.65 4.14,1.15 1.03,-0.24 2.16,-0.07 3.22,-0.11 1.33,-0.06 3.17,-0.44 4.72,-0.25 0.56,0.07 0.93,0.23 1.64,0.25 2.17,0.06 4.13,0.11 6.28,0.52l8.16 1.88c3.51,1 5.6,2.26 7.41,2.86 1.55,0.52 3.2,1.36 4.55,2.24l7.11 4.62c0.41,0.3 0.46,0.23 0.96,0.69l1.84 1.45c0.54,0.49 1.1,1.24 1.75,1.74 1.16,0.89 2.34,1.78 3.22,2.96 0.82,1.1 1.89,1.93 2.59,2.96l2.24 2.88c0.95,1.17 2.73,3.74 3.37,5.1 1.14,2.44 2.2,3.48 3.46,6.8 0.41,1.1 0.89,2.5 1.51,3.48 1.11,-0.01 1.27,-0.81 1.99,-1.39l2.15 -1.57c1.49,-0.95 2.84,-2.11 4.45,-2.93 0.8,-0.4 1.58,-0.78 2.34,-1.15l5.15 -2.26c3.79,-1.37 7.39,-1.86 8.55,-2.28 1.37,-0.49 8.9,-0.45 10.51,-0.43 2.86,0.04 7.47,1.53 9.61,1.4 0.05,-1.84 0.9,-4.98 1.47,-6.53 0.39,-1.08 0.6,-2.07 1.07,-3.04 0.29,-0.58 0.33,-0.87 0.58,-1.45 0.25,-0.58 0.42,-0.93 0.68,-1.41 0.9,-1.65 1.56,-3.29 2.6,-4.81 0.03,-0.03 0.06,-0.08 0.09,-0.12l2.72 -3.85c0.3,-0.36 0.64,-0.68 0.93,-1.1 1.12,-1.61 2.49,-2.73 3.91,-4.13 0.38,-0.38 0.67,-0.73 1,-1.05 1.34,-1.29 4.58,-3.45 6.09,-4.43l4.98 -2.78c0.71,-0.38 2.12,-1.07 2.84,-1.28l4.48 -1.49c0.49,-0.13 1.05,-0.23 1.66,-0.4 2.45,-0.7 4.07,-0.63 5.26,-0.92 3.73,-0.91 11.88,-0.3 15.95,0.82l8.3 2.79c1.54,0.68 3.27,1.37 4.62,2.38l1.93 1.15c0.53,0.38 0.72,0.42 1.21,0.84l4.63 3.6c0.67,0.62 0.44,0.53 1.52,0.44 0.4,-0.99 1.07,-1.68 1.63,-2.57l0.48 -0.75c0.