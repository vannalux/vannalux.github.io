              "text-align": "left"
            },
            ".main-button": {
              "margin-bottom": "2rem",
              "@media (max-width: 767px)": {
                "margin-bottom": "2rem"
              }
            },
            ".mbr-text UL": {
              "text-align": "left"
            },
            ".mbr-section-subtitle, .main-button": {
              "color": "#ffffff"
            },
            ".accordion": {
              "max-width": "990px",
              "background": "rgba(0, 0, 0, 0.1)",
              "height": "300px",
              "margin": "20px auto",
              "display": "flex",
              "box-shadow": "0px 20px 30px rgba(0, 0, 0, 0.47)",
              "flex-direction": "row",
              "cursor": "pointer",
              "margin-bottom": "100px"
            },
            ".box": {
              "position": "relative",
              "height": "100%",
              "flex": "1",
              "background-position": "left",
              "background-size": "cover",
              "transition": ".7s",
              "box-shadow": "0px 20px 30px rgba(0, 0, 0, 0.47)"
            },
            ".box:hover": {
              "flex": "7",
              "height": "400px",
              "filter": "grayscale(0%)"
            },
            ".a1": {
              "background-image": "url(@imagevalue1)",
              "& when (@grayScale2)": {
                "filter": "grayscale(0%)"
              },
              "& when (@grayScale2 = false)": {
                "filter": "grayscale(100%)"
              }
            },
            ".a2": {
              "background-image": "url(@imagevalue2)",
              "& when (@grayScale2)": {
                "filter": "grayscale(0%)"
              },
              "& when (@grayScale2 = false)": {
                "filter": "grayscale(100%)"
              }
            },
            ".a3": {
              "background-image": "url(@imagevalue3)",
              "& when (@grayScale2)": {
                "filter": "grayscale(0%)"
              },
              "& when (@grayScale2 = false)": {
                "filter": "grayscale(100%)"
              }
            },
            ".a4": {
              "background-image": "url(@imagevalue4)",
              "& when (@grayScale2)": {
                "filter": "grayscale(0%)"
              },
              "& when (@grayScale2 = false)": {
                "filter": "grayscale(100%)"
              }
            },
            ".a5": {
              "background-image": "url(@imagevalue5)",
              "& when (@grayScale2)": {
                "filter": "grayscale(0%)"
              },
              "& when (@grayScale2 = false)": {
                "filter": "grayscale(100%)"
              }
            },
            "p": {
              "font-weight": "normal",
              "font-family": "'Exo 2', sans-serif"
            },
            ".text": {
              "position": "absolute",
              "bottom": "0",
              "opacity": "0",
              "padding": "10px"
            },
            ".box:hover .text": {
              "opacity": "1",
              "background": "rgba(red(@colorbarre1), green(@colorbarre1), blue(@colorbarre1), @overlayOpacitybarre1)"
            },
            "@media screen and (max-width: 800px)": {
              "body": {
                "margin": "0"
              },
              ".accordion": {
                "flex-direction": "column",
                "height": "700px",
                "box-shadow": "none"
              },
              ".box": {
                "box-shadow": "none"
              },
              ".box:hover": {
